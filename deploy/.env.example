# TallyBIZ server config. Copy to deploy/.env (chmod 600), fill in, never commit.

# Public hostname. The outside reverse proxy must route it to tallybiz-web:8080.
TALLYBIZ_ADDRESS=tallybiz.example.com

# Docker network of the reverse proxy that owns ports 80/443 (docker network ls).
EDGE_NETWORK=proxy_edge

# Images: ghcr.io/<owner>/tallybiz-{api,web}:<tag>. Owner must be lowercase.
# Tag "main" tracks the latest green build; pin a commit sha to roll back.
TALLYBIZ_GHCR_OWNER=example-owner
TALLYBIZ_IMAGE_TAG=main

# Generate each with: openssl rand -hex 32
TALLYBIZ_SECRET_KEY=
TALLYBIZ_DB_PASSWORD=

# Optional: URL pinged after each healthy deploy run (e.g. healthchecks.io).
DEPLOY_PING_URL=

# Optional: daily database dumps (deploy/backup-db.sh). Defaults: ./backups, 14.
# BACKUP_DIR=/var/backups/tallybiz
# BACKUP_KEEP=30
